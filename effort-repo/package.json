{
  "name": "effortcast",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Weather, translated into athletic effort.",
  "scripts": {
    "test": "node --test tests/engine.test.mjs tests/strain.test.mjs",
